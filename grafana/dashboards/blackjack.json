    {
      "id": 13,
      "type": "timeseries",
      "title": "CPU busy %",
      "description": "node exporter in a container reads the VM's /proc, so this is the shared VM's CPU, not just ours",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 - avg by (product) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100",
          "legendFormat": "{{product}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
