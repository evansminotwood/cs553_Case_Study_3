GROUP=group10

# Start of the port range claimed in the class sheet (2000-2010):
#   +0 API UI     +1 API metrics    +2 API node exporter
#   +3 local UI   +4 local metrics  +5 local node exporter
#   +6 Prometheus +7 Grafana        +8 ngrok inspector (localhost only)  +9 gateway
PORT_BASE=2000

VM_HOST=melnibone.wpi.edu
VM_PORT=2222
VM_USER=group10
VM_KEY=$HOME/.ssh/cs553_group
VM_DIR=cs553_case_study_3

# Class-wide Docker network; the product containers join it if it exists.
SHARED_NETWORK=monitoring

# ngrok (needs NGROK_AUTHTOKEN) or cloudflared (no account needed)
TUNNEL=ngrok
